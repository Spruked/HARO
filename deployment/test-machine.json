{
  "notes": [
    "Deployment configuration for the RTX 5060 test machine. Endpoints come from earlier configuration and tests and must be confirmed by live validation.",
    "Credentials are referenced by environment variable only.",
    "Bindings exist only where the model is known. Ollama models are not bound until the installed inventory is confirmed.",
    "Voice Studio is tracked on device 0 but remains ungated until live validation measures its per-request memory."
  ],
  "telemetry": {"provider": "nvidia-smi"},
  "fabric": {
    "safety_margin_mib": 256,
    "allow_eviction": false,
    "device_concurrency": {"0": 1}
  },
  "adapters": [
    {"id": "local-ollama", "type": "ollama", "base_url": "http://127.0.0.1:11434", "device": {"index": 0}},
    {"id": "local-llama-server", "type": "llama_cpp", "base_url": "http://127.0.0.1:16520"},
    {"id": "voice-studio", "type": "openai_audio", "base_url": "http://127.0.0.1:3900/v1", "device": {"index": 0}},
    {"id": "remote-openai-compatible", "type": "openai_compatible", "base_url": "https://integrate.api.nvidia.com/v1",
     "location": "remote", "api_key_env": "NVIDIA_API_KEY"}
  ],
  "bindings": [
    {"capability": "chat", "adapter": "remote-openai-compatible", "model": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning", "approved_work_types": ["reasoning", "analysis", "planning"]},
    {"capability": "speech_synthesis", "adapter": "voice-studio", "model": "omnivoice", "approved_work_types": ["voice_output"], "memory_gating": "tracked_unmeasured"},
    {"capability": "speech_recognition", "adapter": "voice-studio", "model": "Systran/faster-whisper-large-v3", "approved_work_types": ["transcription"], "memory_gating": "tracked_unmeasured"}
  ]
}
